msgstr "Trình trợ giúp đăng nhập không khởi động được"

#: helper/main.cpp
msgid "Expected a login request"
msgstr "Cần một yêu cầu đăng nhập"

#: helper/main.cpp
msgid "Incomplete login request"
msgstr "Yêu cầu đăng nhập không đầy đủ"

#: helper/main.cpp
msgid "No command or no account to start"
msgstr "Không có lệnh hoặc tài khoản để khởi động"
