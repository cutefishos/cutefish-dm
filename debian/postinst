#! /bin/sh
# see: dh_installdeb(1)

set -e

case "$1" in
    configure)
        # The login screen's own user; it owns nothing but its home.
        if ! getent passwd cutefish-greeter >/dev/null; then
            adduser --system --group --home /var/lib/cutefish-greeter \
                --gecos "Cutefish login screen" --quiet cutefish-greeter
        fi
        mkdir -p /var/lib/cutefish-dm
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
